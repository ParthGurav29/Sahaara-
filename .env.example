# Sahaara — Environment Variables
# Copy this to .env and fill in your keys.
# See AGENTS.md for full documentation.

# LLM Provider (Nebius Token Factory)
LLM_PROVIDER=nemotron
NEBIUS_API_KEY=your-nebius-api-key

# Optional model overrides (defaults work fine)
# SAHAARA_MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# SAHAARA_MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b
# SAHAARA_MODEL_LIGHTNING=nvidia/Nemotron-3_5-Lightning

# ASR (Deepgram)
DEEPGRAM_API_KEY=your-deepgram-api-key

# TTS (Cartesia)
CARTESIA_API_KEY=your-cartesia-api-key
CARTESIA_VOICE_ID=your-voice-id

# Auth (M2) — feature-gated by SAHAARA_AUTH_ENABLED
# SAHAARA_AUTH_ENABLED=true          # Enable caregiver authentication (default: false)
# SAHAARA_SEED_USER=caregiver        # Seed caregiver username (required if auth enabled)
# SAHAARA_SEED_PASSWORD=demo123      # Seed caregiver password (required if auth enabled)
# SAHAARA_TOKEN_EXPIRY_HOURS=12      # Token expiry in hours (default: 12)
# SAHAARA_COOKIE_SECURE=true         # Session cookie gets the Secure attribute (M5 Step 1
#                                    # condition 2). Keep OFF/default for http://localhost,
#                                    # 127.0.0.1 and adb reverse; turn ON wherever the app is
#                                    # served over HTTPS, or the browser stops sending it.

# Frontend API base (Vite build-time; default /api uses the Vite proxy)
# Put this in frontend/.env.local, not the backend .env.
# VITE_API_BASE_URL=/api
# Optional WebSocket override; normally derived from the current page.
# VITE_VOICE_WS_URL=wss://your-tunnel.example/ws/voice
# Vite dev/preview proxy target (server-side only; never shipped to the browser).
# The one place the backend port is written for the frontend. Default :8000.
# VITE_DEV_API_TARGET=http://127.0.0.1:8000

# M5 PWA / Web Push — TWO gates, both default OFF (owner decision 6, B).
# Push only works when BOTH are ON.
#   SAHAARA_PUSH_ENABLED  backend send gate (runtime, read by GET /config)
#   VITE_PUSH_ENABLED     frontend build gate (compile-time; set in frontend/.env.local)
# With VITE_PUSH_ENABLED off, no service worker registers and no push surface
# renders at all — a runtime flag alone cannot guarantee that.
SAHAARA_PUSH_ENABLED=false
# VITE_PUSH_ENABLED=false

# M5 Step 3 — VAPID keys for Web Push. Server-side only: these go in backend/.env
# (which git ignores), NEVER in this file and never in the frontend.
#   VAPID_PRIVATE_KEY  one-line PEM with escaped newlines ("-----BEGIN PRIVATE KEY-----\n...")
#   VAPID_SUBJECT      contact string for the push service (mailto: or https:)
#   VAPID_PUBLIC_KEY   optional override; derived from the private key when blank
# Generate once with:
#   cd backend && .venv/bin/python -c "from py_vapid import Vapid; from cryptography.hazmat.primitives import serialization as s; import base64; v=Vapid(); v.generate_keys(); print(v.private_pem().decode().replace(chr(10),'\\\\n')); print(base64.urlsafe_b64encode(v.public_key.public_bytes(s.Encoding.X962, s.PublicFormat.UncompressedPoint)).decode().rstrip('='))"
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:caregiver@example.com

# M5 Step 5 — the send path (backend/push_notify.py). Only active when
# SAHAARA_PUSH_ENABLED is ON and a VAPID private key is configured.
# Only an UPWARD tier move rings a phone: Green, consent outcomes, fallback
# notices and de-escalations stay on the dashboard.
# Cooldown is per profile and stored in SQLite (push_cooldown_state), so a
# restart cannot reset it. An escalation always sends, even inside the window
# of the lower tier that came before it.
#   SAHAARA_PUSH_COOLDOWN_YELLOW_SECONDS   default 1800
#   SAHAARA_PUSH_COOLDOWN_ORANGE_SECONDS   default 600
#   SAHAARA_PUSH_COOLDOWN_RED_SECONDS      default 120
#   SAHAARA_PUSH_COOLDOWN_SECONDS          one explicit value for every tier;
#                                          wins over the three above (0 disables)
#   SAHAARA_PUSH_TTL_SECONDS               how long the push service may hold a
#                                          message for a sleeping/offline phone
#                                          (default 3600; pywebpush's own
#                                          default of 0 drops it)
# SAHAARA_PUSH_COOLDOWN_YELLOW_SECONDS=1800
# SAHAARA_PUSH_COOLDOWN_ORANGE_SECONDS=600
# SAHAARA_PUSH_COOLDOWN_RED_SECONDS=120
# SAHAARA_PUSH_COOLDOWN_SECONDS=
# SAHAARA_PUSH_TTL_SECONDS=3600
